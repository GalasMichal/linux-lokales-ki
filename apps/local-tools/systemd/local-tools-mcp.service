[Unit]
Description=Lokale KI-Werkzeuge (MCP, localhost only)
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/ai/apps/local-tools
ExecStart=/srv/ai/venvs/local-tools/bin/uvicorn server:app --host 127.0.0.1 --port 8765 --workers 1 --limit-concurrency 8 --timeout-keep-alive 10
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=NO_PROXY=127.0.0.1,localhost,host.containers.internal
Environment=PATH=/home/mike/.local/bin:/usr/bin:/usr/local/bin:/bin
Environment=PYTHONPATH=/home/mike/.local/lib/python3.14/site-packages:/usr/lib64/python3.14/site-packages:/usr/lib/python3.14/site-packages
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0
Environment=BROWSER_EXECUTABLE=/usr/bin/brave-browser
ReadWritePaths=/home/mike/Projects /srv/ai/workspaces /mnt/ai-archive /srv/ai/cache
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET

[Install]
WantedBy=default.target
