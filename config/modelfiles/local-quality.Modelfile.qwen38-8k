# Rollback QUALITY alias to Qwen3.8 27B / 8K.
# Parent weights stay qwen3.8:27b. Do not delete 16k/32k bench aliases.
FROM qwen3.8:27b
PARAMETER num_ctx 8192
PARAMETER presence_penalty 1.5
PARAMETER temperature 1
PARAMETER top_k 20
PARAMETER top_p 0.95
PARAMETER min_p 0
PARAMETER repeat_penalty 1
PARAMETER draft_num_predict 4
